{
  "name": "economics-game",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check": "npm run lint && npm run build && npm run balance -- 250 && npm run balance:agenda -- 60 && npm run validate:content && npm run validate:arcs",
    "balance": "node --experimental-strip-types scripts/simulate-balance.mjs",
    "validate:content": "node --experimental-strip-types scripts/validate-educational-content.mjs",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "dist": "npm run build && electron-builder",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "balance:agenda": "node --experimental-strip-types scripts/simulate-agenda.mjs",
    "validate:arcs": "node --experimental-strip-types scripts/validate-arcs.mjs"
  },
  "build": {
    "appId": "com.postcolonialrepublic.game",
    "productName": "Post-Colonial Republic",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.strategy-games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Post-Colonial Republic"
    }
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
